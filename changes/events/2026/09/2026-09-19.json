    {
      "id": "evt_2026-09-19T121756809Z_119-hr-10170_bill.summary_changed",
      "observedAt": "2026-09-19T12:17:56.809Z",
      "entityType": "bill",
      "entityId": "119-hr-10170",
      "changeType": "bill.summary_changed",
      "summary": "Official summary added",
      "before": {
        "summary": null,
        "summaryFormat": null
      },
      "after": {
        "summary": "Memory Chip Competitiveness Assessment Act of 2026 This bill requires the Department of Commerce to study and report on the advanced memory technology marketplace. Under the bill, advanced memory technology means semiconductor memory products manufactured using leading-edge process technologies and primarily designed for high-performance, high-bandwidth, or energy-efficient computing applications. The study must assess the advanced memory technology supply chain, the impact of market trends on the cost of end products, and mechanisms to increase supply (without acquiring products from North Korea, China, Russia, or Iran). Commerce must provide an opportunity for public comment on the report before finalizing it.",
        "summaryFormat": "html"
      },
      "officialUrl": "https://www.congress.gov/bill/119th-congress/house-bill/10170",
      "syncId": "2026-09-19T12:17:56.809Z"
    },
